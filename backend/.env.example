# Copy this file to .env and fill in what you need. Everything is optional.

# Gemini API key from https://aistudio.google.com/apikey
# Without it, BillBuddy still works: the rules parser handles extraction and the
# summary uses a template.
GEMINI_API_KEY=

# Which Gemini model to call. Change this if Google renames or retires the alias.
GEMINI_MODEL=gemini-flash-latest

# auto   = rules parser first, Gemini only if the layout isn't recognised (default)
# rules  = never call Gemini for extraction
# gemini = always use Gemini for extraction
EXTRACTOR=auto

# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Windows only, if Tesseract isn't on your PATH:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
